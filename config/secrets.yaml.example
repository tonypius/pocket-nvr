# Copy to secrets.yaml next to config.yaml; chmod 600 (FR-CFG-2, FLAG-13).
# Real values, never committed, never logged.

api_token: <random-64-hex>          # required; used for all /api calls
mediamtx_viewer_pass: <random>      # MediaMTX viewer account password

front_user: <tapo camera account user>
front_pass: <tapo camera account pass>

back_user: <cpplus onvif user>
back_pass: <cpplus onvif pass>

ntfy_topic_url: https://ntfy.sh/<private-topic>
telegram_bot_token: ""
telegram_chat_id: ""
